{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "gps-poc": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_GPS_POC": "1"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://dallimo.gamjabox.cloud",
        "APP_LINK_DOMAIN": "dallimo.gamjabox.cloud"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
