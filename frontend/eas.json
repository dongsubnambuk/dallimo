{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "gps-poc": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_GPS_POC": "1"
      }
    },
    "production": {
      "autoIncrement": true
    }
  }
}
