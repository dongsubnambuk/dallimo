{
  "expo": {
    "name": "DALLIMO",
    "slug": "dallimo",
    "scheme": "dallimo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "infoPlist": {
        "CFBundleDisplayName": "달리모",
        "ITSAppUsesNonExemptEncryption": false,
        "NSHealthShareUsageDescription": "Apple Watch나 다른 앱으로 달린 기록을 달리모로 가져오려고 건강 앱의 운동과 경로를 읽어요.",
        "NSHealthUpdateUsageDescription": "달리모로 달린 기록을 건강 앱에 운동으로 저장해요."
      },
      "entitlements": {
        "com.apple.developer.healthkit": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#0B0B0C",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "./plugins/with-android-display-name",
        {
          "displayName": "달리모"
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "달린 경로와 거리를 기록하고 내 주변 코스를 찾는 데 위치를 사용해요.",
          "locationAlwaysAndWhenInUsePermission": "화면을 끄거나 다른 앱을 써도 달리기 기록이 이어지도록 위치를 사용해요. 달리지 않을 때는 위치를 모으지 않아요.",
          "locationAlwaysPermission": "화면을 끄거나 다른 앱을 써도 달리기 기록이 이어지도록 위치를 사용해요. 달리지 않을 때는 위치를 모으지 않아요.",
          "motionUsagePermission": "달리는 중과 멈춘 때를 구분해 기록을 정확하게 남기는 데 동작 정보를 사용해요. 지금은 이 권한을 요청하지 않아요.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#0B0B0C"
        }
      ],
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.dongseopseo.dallimo.watchkitapp",
                  "targetName": "DallimoWatch",
                  "entitlements": {
                    "com.apple.developer.healthkit": true
                  }
                }
              ]
            }
          }
        },
        "projectId": "283cb7b2-62b8-4220-a4dc-5773de7c3efb"
      }
    }
  }
}
