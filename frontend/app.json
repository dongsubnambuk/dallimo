{
  "expo": {
    "name": "DALLIMO",
    "slug": "dallimo",
    "scheme": "dallimo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "CFBundleDisplayName": "달리모"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "./plugins/with-android-display-name",
        {
          "displayName": "달리모"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "프로필 사진을 고르기 위해 사진 보관함에 접근해요.",
          "cameraPermission": false
        }
      ],
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "달린 경로와 거리를 기록하고 주변 코스를 찾을 때 위치를 사용해요.",
          "locationAlwaysAndWhenInUsePermission": "화면을 끄고 달려도 경로와 거리를 이어서 기록하려고 위치를 사용해요.",
          "locationAlwaysPermission": "화면을 끄고 달려도 경로와 거리를 이어서 기록하려고 위치를 사용해요.",
          "motionUsagePermission": false,
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
