{
  "expo": {
    "name": "DALLIMO",
    "slug": "dallimo",
    "scheme": "dallimo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "infoPlist": {
        "CFBundleDisplayName": "달리모",
        "NSHealthShareUsageDescription": "Apple 건강에 저장된 달리기 기록(Apple Watch 등)을 달리모로 가져오기 위해 운동과 경로를 읽어요."
      },
      "entitlements": {
        "com.apple.developer.healthkit": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#0B0B0C",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "./plugins/with-android-display-name",
        {
          "displayName": "달리모"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "프로필 사진을 고르기 위해 사진 보관함에 접근해요.",
          "cameraPermission": false
        }
      ],
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "달린 경로와 거리를 기록하고 주변 코스를 찾을 때 위치를 사용해요.",
          "locationAlwaysAndWhenInUsePermission": "화면을 끄고 달려도 경로와 거리를 이어서 기록하려고 위치를 사용해요.",
          "locationAlwaysPermission": "화면을 끄고 달려도 경로와 거리를 이어서 기록하려고 위치를 사용해요.",
          "motionUsagePermission": false,
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#0B0B0C"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
