# 운영 서버(prod) 환경변수 목록. 개발(dev)은 application-dev.yaml에 기본값이 있어 넣지 않아도 된다. 복사해서 배포 환경에 넣는다 (.env는 저장소에 올라가지 않는다)
# 비밀 값은 여기 적지 않는다. 설명은 backend/README.md "배포 환경변수" · "프록시"
# prod 서버가 뜰 때 빠진 선택 설정은 로그 "deploy.config missing="으로 알려 준다
# 공유 주소 · App Link(SHARE_PUBLIC_BASE_URL · APP_LINK_*)는 prod 프로필만 읽는다

# ── 필수: 없으면 서버가 시작하지 않는다 ─────────────────────────────
SPRING_PROFILES_ACTIVE=prod
DB_HOST=
DB_PORT=3306
DB_NAME=dallimo
DB_USERNAME=
DB_PASSWORD=
# 기본 mysql. MariaDB면 mariadb
DB_DRIVER=mysql
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
# openssl rand -base64 32
JWT_SECRET=
# 브라우저에서 부를 수 있는 출처(쉼표로 여럿). 웹으로 띄운 앱에서 부를 때만. 예: http://localhost:8081
CORS_ALLOWED_ORIGINS=

# ── 공개 주소 ──────────────────────────────────────────────
# 공유 링크 https://dallimo.gamjabox.cloud/s/{code}. gamjabox 배포는 compose.yaml에 적혀 있다
SHARE_PUBLIC_BASE_URL=https://dallimo.gamjabox.cloud

# ── 공유 링크로 앱 바로 열기 (App Link · Universal Link) ────────────────
# {Apple 팀 ID}.{iOS 번들 ID}. 여럿이면 쉼표. gamjabox 배포는 compose.yaml에 적혀 있다
APP_LINK_IOS_APP_IDS=Q336TS439T.com.dongseopseo.dallimo
APP_LINK_ANDROID_PACKAGE=com.dongseopseo.dallimo
# Play Console 앱 서명 키의 SHA-256 (AA:BB:… 형식). 여럿이면 쉼표
APP_LINK_ANDROID_SHA256=

# ── 관리 API (외부 코스 가져오기 · 신고 코스 검토, X-Admin-Key) ─────────
ADMIN_API_KEY=
# 신고가 몇 건 쌓이면 자동으로 숨길지 (기본 3)
COURSE_AUTO_HIDE_REPORTS=3

# ── 강제 업데이트 (backend/README.md "앱 버전") ─────────────────────
# 이 버전보다 낮은 앱은 "업데이트가 필요해요" 화면에서 스토어로 보낸다. 비어 있으면 막지 않는다. 예: 1.0.1
APP_MIN_VERSION_IOS=
# App Store 앱 주소. App Store Connect › 앱 정보 › Apple ID(숫자)로 https://apps.apple.com/app/id{숫자}
APP_STORE_URL_IOS=

# ── 외부 추천 코스 ────────────────────────────────────────────────
# 공공데이터포털 두루누비 일반 인증키(Decoding)
DATA_GO_KR_SERVICE_KEY=
# 예: 0 0 4 * * MON (매주 월 04:00 UTC). "-"면 돌지 않는다
EXTERNAL_COURSE_CRON=-
# 예: 35.80,128.55,35.90,128.70;37.50,126.90,37.60,127.05
EXTERNAL_COURSE_OSM_BOXES=
# Open-Meteo 고도. 무료 API는 비상업 이용 조건
EXTERNAL_ELEVATION_ENABLED=false

# ── Push ─────────────────────────────────────────────────────────
# Expo "Enhanced push security"를 켰을 때만
EXPO_ACCESS_TOKEN=

# ── 프록시 ──────────────────────────────────────────────────────
# 프록시가 사설 · 루프백 주소가 아닐 때만. 그 주소의 정규식. 예: 203\.0\.113\.10
# SERVER_TOMCAT_REMOTEIP_INTERNALPROXIES=
